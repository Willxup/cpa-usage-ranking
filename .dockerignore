# Only the service and frontend build inputs enter the context.
**
!go.mod
!go.sum
!cmd/
!cmd/ranking/
!cmd/ranking/*.go
!internal/
!internal/**/
!internal/**/*.go
!internal/avatars/assets/catalog.json
!internal/avatars/assets/images/*.webp
!web/
!web/package.json
!web/package-lock.json
!web/index.html
!web/tsconfig.json
!web/vite.config.ts
!web/public/
!web/public/**
!web/src/
!web/src/**
!web/test/
!web/test/*.ts
!config/
!config/models.json
!THIRD_PARTY_NOTICES.md
!third_party/
!third_party/react-bits/
!third_party/react-bits/LICENSE.md

# Go test fixtures aren't needed by the image build. TypeScript's build
# configuration does include web/test/*.ts and web/src/**/test/*.ts(x).
internal/**/test/
internal/**/*_test.go
**/node_modules/
**/dist/
**/.git
**/.worktrees/
**/plans/
**/AGENTS.md
**/.agents/
**/.claude/
**/.codex/
**/.pi/
**/.ssh/
**/*.sqlite
**/*.sqlite-*
**/*.sqlite3
**/*.sqlite3-*
**/.env
**/.env.*
**/*.db
**/*.db-*
**/*.log
**/*.key
**/*.pem
